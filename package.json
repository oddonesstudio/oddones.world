{
  "name": "oddones-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--localstorage-file=$PWD/studio/.sanity/localstorage bunx next dev",
    "build": "bun run sanity:types && NODE_OPTIONS=--localstorage-file=$PWD/studio/.sanity/localstorage bunx next build",
    "start": "NODE_OPTIONS=--localstorage-file=$PWD/studio/.sanity/localstorage bunx next start",
    "sanity:types": "bun install --cwd studio --frozen-lockfile && bun run --cwd studio sanity:types",
    "sb:dev": "storybook dev -p 6006",
    "sb:build": "storybook build"
  },
  "dependencies": {
    "@portabletext/react": "^4.0.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/preview-url-secret": "^4.0.6",
    "@sanity/vision": "4.10.2",
    "@storybook/addon-docs": "^10.1.11",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "groqd": "^1.7.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.23.24",
    "next": "^16.2.5",
    "next-sanity": "11.4.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.6",
    "sanity": "4.10.2",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.15",
    "postcss": "^8.5.6",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
