# Odd Ones World environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Don't commit real secrets 🤫

# Sanity content API
# Public because the browser needs these to render Sanity-backed pages.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Sanity Studio URL used by visual editing and stega links.
# Use the local Studio URL while developing.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# Public production site URL used for canonical URLs, Open Graph URLs, robots.txt,
# and sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Server-only Sanity token used for draft preview and live content.
# Create a read token in Sanity with access to the dataset above.
SANITY_API_READ_TOKEN="your-sanity-read-token"

# Secret used to verify Sanity webhook requests to `/api/revalidate`.
SANITY_REVALIDATE_SECRET="your-sanity-webhook-secret"
