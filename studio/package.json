{
  "name": "oddones-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --localstorage-file=$PWD/.sanity/localstorage --max-http-header-size=65536 ./node_modules/@sanity/cli/bin/run.js dev",
    "start": "node --localstorage-file=$PWD/.sanity/localstorage --max-http-header-size=65536 ./node_modules/@sanity/cli/bin/run.js start",
    "build": "node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js build",
    "deploy": "node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js deploy",
    "sanity:extract": "XDG_CONFIG_HOME=$PWD/.sanity/config node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js schema extract --path ./schema.json",
    "sanity:typegen": "XDG_CONFIG_HOME=$PWD/.sanity/config node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js typegen generate",
    "sanity:types": "XDG_CONFIG_HOME=$PWD/.sanity/config node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js schema extract --path ./schema.json && XDG_CONFIG_HOME=$PWD/.sanity/config node --localstorage-file=$PWD/.sanity/localstorage ./node_modules/@sanity/cli/bin/run.js typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/cli": "^6.5.0",
    "@sanity/color-input": "^6.0.4",
    "@sanity/vision": "^5.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanity": "^5.24.0",
    "sanity-plugin-media": "^4.2.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@sanity/codegen": "^6.0.3",
    "@types/react": "^19.2.14",
    "baseline-browser-mapping": "^2.10.27",
    "prettier": "^3.8.3",
    "typescript": "^5.8"
  }
}
