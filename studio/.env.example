# Odd Ones Studio environment variables
#
# Copy this file to `studio/.env.local` when running Sanity Studio directly:
#   cp studio/.env.example studio/.env.local
#
# Don't commit real secrets 🤫

# URL of the Next.js app used by the Presentation tool and document preview.
SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"

# Optional: local Studio URL for any shared preview/visual-editing code.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

# Server-only Sanity token used when preview integrations need authenticated reads.
SANITY_API_READ_TOKEN="your-sanity-read-token"
